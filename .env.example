# TwitchDownloaderCLI binary name or full path
TWITCH_DOWNLOADER_CLI=TwitchDownloaderCLI

FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
AUTO_EDITOR_BIN=auto-editor

# Optional caption backends
WHISPERX_ENABLED=false
# OPENSHORTS_DIR=C:\path\to\openshorts

CHAT_WINDOW_SECONDS=8
CHAT_SPIKE_MULTIPLIER=2.5
CHAT_MIN_MESSAGES=12
CLIP_PRE_SECONDS=20
CLIP_POST_SECONDS=25
MAX_CLIPS=12